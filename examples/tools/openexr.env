#!/usr/bin/env envstack
include: [default, numpy]
all: &all
  OPENEXR_VERSION: ${OPENEXR_VERSION:=3.4.13}
  OPENEXR_ROOT: ${OPENEXR_ROOT:=${DEPLOY_ROOT}/tools/openexr/${OPENEXR_VERSION}}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${OPENEXR_ROOT}/darwin/lib/python
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${OPENEXR_ROOT}/linux/lib/python
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${OPENEXR_ROOT}/windows/lib/python
  PATH: ${PATH};${OPENEXR_ROOT}/windows/bin
