#!/usr/bin/env envstack
include: [default]
all: &all
  PILLOW_VERSION: ${PILLOW_VERSION:=12.3.0}
  PILLOW_ROOT: ${PILLOW_ROOT:=${DEPLOY_ROOT}/tools/pillow/${PILLOW_VERSION}}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PILLOW_ROOT}/darwin/lib/python
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PILLOW_ROOT}/linux/lib/python
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PILLOW_ROOT}/windows/lib/python
  PATH: ${PATH};${PILLOW_ROOT}/windows/bin
