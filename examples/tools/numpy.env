#!/usr/bin/env envstack
include: [default]
all: &all
  NUMPY_VERSION: ${NUMPY_VERSION:=2.2.6}
  PYVERSION: $(python -c "import sys; print(f'{sys.version_info[0]}.{sys.version_info[1]}')")
  NUMPY_ROOT: ${NUMPY_ROOT:=${DEPLOY_ROOT}/tools/numpy/${NUMPY_VERSION}}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${NUMPY_ROOT}/darwin/python${PYVERSION}/lib/python
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${NUMPY_ROOT}/linux/python${PYVERSION}/lib/python
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${NUMPY_ROOT}/windows/python${PYVERSION}/lib/python
