#!/usr/bin/env envstack
include: [default]
all: &all
  TOOLA_ROOT: ${TOOLA_ROOT:=${ROOT}/tools/toola}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLA_ROOT}/darwin
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLA_ROOT}/linux
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLA_ROOT}/windows
