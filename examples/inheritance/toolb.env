#!/usr/bin/env envstack
include: [default]
all: &all
  TOOLB_ROOT: ${TOOLB_ROOT:=${ROOT}/tools/toolb}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLB_ROOT}/darwin
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLB_ROOT}/linux
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${TOOLB_ROOT}/windows
