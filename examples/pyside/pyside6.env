#!/usr/bin/env envstack
include: [default]
all: &all
  PYSIDE6_VERSION: ${PYSIDE6_VERSION:=6.8.3}
  PYSIDE6_ROOT: ${PYSIDE6_ROOT:=${DEPLOY_ROOT}/tools/pyside6/${PYSIDE6_VERSION}}
darwin:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PYSIDE6_ROOT}/darwin/lib/python
linux:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PYSIDE6_ROOT}/linux/lib/python
windows:
  <<: *all
  PYTHONPATH: ${PYTHONPATH}:${PYSIDE6_ROOT}/windows/lib/python
